# The image build needs only these files. An allowlist prevents credentials,
# Git history, local configuration, and editor backups from reaching the builder.
*
!Dockerfile
!Dockerfile.update
!Dockerfile.dev
!entrypoint.sh
!dev-profile.sh
!dev-shell.sh
!dev-configure.sh
!dev-proxy-run.sh
!dev-tools.sh
!aibox-dev-proxy.service
!network-lockdown.sh
!user-exec.sh
!enter-shell.sh
!third_party/
!third_party/.gitkeep
!third_party/gost
!third_party/jdk8.tar.gz
!third_party/maven.tar.gz

# Clipboard image bridge: only the two guest-side scripts belong in the image.
# The macOS half (AppleScript watcher + launchd plist) never enters a container.
!clipboard-bridge/
!clipboard-bridge/xclip-shim.sh
!clipboard-bridge/img.sh
